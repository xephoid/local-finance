# Source explicitly in your shell; the application never reads dotenv files.
# Copy to an ignored .env, chmod 600, and edit before using real credentials.
FINANCE_DATA_DIR=./data
# Optional override; otherwise DATA_DIR/simplefin_access_url is used.
# FINANCE_SIMPLEFIN_CREDENTIAL=./data/simplefin_access_url
FINANCE_BIND=127.0.0.1
FINANCE_PORT=8787
# Add your own LAN IP and DNS name before first init; no wildcard hostnames.
FINANCE_TLS_SANS=localhost,127.0.0.1
FINANCE_OLLAMA_URL=http://localhost:11434
FINANCE_OLLAMA_MODEL=qwen3:8b
# Supervisor-only opt-ins (serve CLI uses --scheduler / --model):
FINANCE_SCHEDULER=0
FINANCE_MODEL_ENABLED=0
# Optional; BOTH must be explicitly configured to deliver notifications.
# TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
# TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_NUMERIC_CHAT_ID
# Docker Compose publish address; set to your own LAN interface IP, never public.
FINANCE_LAN_IP=127.0.0.1
